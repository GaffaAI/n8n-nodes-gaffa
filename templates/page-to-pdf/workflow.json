            {
              "id": "p13-1",
              "name": "Last checked",
              "type": "string",
              "value": "={{ $today.toISODate() }}"
            },
            {
              "id": "p13-2",
              "name": "Status",
              "type": "string",
              "value": "no change"
            }
          ]
        },
        "options": {}
      },
      "id": "p13",
      "name": "Note no change",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1952,
        160
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
