{
  "name": "Archive changed web pages as PDFs in Google Drive with Google Sheets and Gaffa",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "p1",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        32
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p2-0",
              "name": "sheet_url",
              "type": "string",
              "value": ""
            },
            {
              "id": "p2-1",
              "name": "sheet_name",
              "type": "string",
              "value": "Pages"
            },
            {
              "id": "p2-2",
              "name": "folder_url",
              "type": "string",
              "value": ""
            },
            {
              "id": "p2-3",
              "name": "wait_seconds",
              "type": "number",
              "value": 5
            }
          ]
        },
        "options": {}
      },
      "id": "p2",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        32
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.sheet_name }}"
        },
        "options": {}
      },
      "id": "p3",
      "name": "Read the pages",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        448,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json['Page URL'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "p4",
      "name": "Only pages with a URL",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        672,
        32
      ]
    },
    {
      "parameters": {
        "operation": "sendRequest",
        "body": "={{ JSON.stringify({\n  url: $json['Page URL'].trim(),\n  max_cache_age: 0,\n  settings: {\n    time_limit: 60000,\n    actions: [\n      { type: 'wait', time: $('Settings').first().json.wait_seconds * 1000 },\n      Object.assign({ type: 'generate_markdown', output_type: 'inline', custom_id: 'text' }, ($json.Selector || '').trim() ? { selector: $json.Selector.trim() } : {}),\n      { type: 'print', custom_id: 'pdf' }\n    ]\n  }\n}) }}",
        "options": {}
      },
      "id": "p5",
      "name": "Read the page",
      "type": "@gaffa-dev/n8n-nodes-gaffa.gaffa",
      "typeVersion": 1,
      "position": [
        976,
        32
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ (($json.actions || []).find((action) => action.custom_id === 'text') || {}).output }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "p6",
      "name": "Page read?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        32
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p7-0",
              "name": "row_number",
              "type": "number",
              "value": "={{ $('Read the pages').item.json.row_number }}"
            },
            {
              "id": "p7-1",
              "name": "Last checked",
              "type": "string",
              "value": "={{ $today.toISODate() }}"
            },
            {
              "id": "p7-2",
              "name": "Status",
              "type": "string",
              "value": "={{ 'could not read the page: ' + ($json.error || 'no text found') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "p7",
      "name": "Note the error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        448
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p8-0",
              "name": "row_number",
              "type": "number",
              "value": "={{ $('Read the pages').item.json.row_number }}"
            },
            {
              "id": "p8-1",
              "name": "hash",
              "type": "string",
              "value": "={{ $json.actions.find((action) => action.custom_id === 'text').output.hash('sha256') }}"
            },
            {
              "id": "p8-2",
              "name": "pdf_url",
              "type": "string",
              "value": "={{ $json.actions.find((action) => action.custom_id === 'pdf').output }}"
            }
          ]
        },
        "options": {}
      },
      "id": "p8",
      "name": "Hash the page text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1504,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.hash }}",
              "rightValue": "={{ $('Read the pages').item.json['Last hash'] }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "p9",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1728,
        32
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.pdf_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "p10",
      "name": "Fetch the PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1952,
        -96
      ]
    },
    {
      "parameters": {
        "name": "={{ ($('Read the pages').item.json.Name || 'page') + ' ' + $today.toISODate() + '.pdf' }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').first().json.folder_url }}"
        },
        "options": {
          "simplifyOutput": false
        }
      },
      "id": "p11",
      "name": "Save to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2176,
        -96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p12-0",
              "name": "row_number",
              "type": "number",
              "value": "={{ $('Hash the page text').item.json.row_number }}"
            },
            {
              "id": "p12-1",
              "name": "Last hash",
              "type": "string",
              "value": "={{ $('Hash the page text').item.json.hash }}"
            },
            {
              "id": "p12-2",
              "name": "Last changed",
              "type": "string",
              "value": "={{ $today.toISODate() }}"
            },
            {
              "id": "p12-3",
              "name": "Last PDF",
              "type": "string",
              "value": "={{ $json.webViewLink }}"
            },
            {
              "id": "p12-4",
              "name": "Last checked",
              "type": "string",
              "value": "={{ $today.toISODate() }}"
            },
            {
              "id": "p12-5",
              "name": "Status",
              "type": "string",
              "value": "={{ $('Read the pages').item.json['Last hash'] ? 'changed, new PDF saved' : 'first PDF saved' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "p12",
      "name": "Note the change",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2400,
        -96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p13-0",
              "name": "row_number",
              "type": "number",
              "value": "={{ $json.row_number }}"
